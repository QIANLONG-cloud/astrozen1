---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author">;

const { author } = Astro.props;
const currentYear = new Date().getFullYear();

const email = "875348468@qq.com";
const phone = "19311432894";
const wechat = "oranngeii";
---

<footer class="w-full border-t border-neutral/20 px-5 pt-16 pb-10 text-center text-white">
  <h2 class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl text-left">
    Contact
  </h2>
  <div class="mx-auto grid max-w-3xl grid-cols-1 gap-6 md:grid-cols-3 text-left">
    <!-- 邮箱 -->
    <div class="rounded-2xl border border-neutral/20 bg-white/5 p-6">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-blue-400">✉</span>
        <span class="text-xs font-medium tracking-wide text-blue-400">邮箱</span>
      </div>
      <div class="whitespace-nowrap text-base font-medium text-white">{email}</div>
    </div>

    <!-- 电话 -->
    <div class="rounded-2xl border border-neutral/20 bg-white/5 p-6">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-blue-400">☏</span>
        <span class="text-xs font-medium tracking-wide text-blue-400">电话</span>
      </div>
      <div class="whitespace-nowrap text-base font-medium text-white">{phone}</div>
    </div>

    <!-- 微信 -->
    <div class="rounded-2xl border border-neutral/20 bg-white/5 p-6">
      <div class="mb-3 flex items-center gap-2">
        <span class="text-blue-400">✦</span>
        <span class="text-xs font-medium tracking-wide text-blue-400">微信</span>
      </div>
      <div class="whitespace-nowrap text-base font-medium text-white">{wechat}</div>
    </div>
  </div>

  <p class="mt-16 text-xs text-neutral">
    {author} © {currentYear}.
  </p>
</footer>
