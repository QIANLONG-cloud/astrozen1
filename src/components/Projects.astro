---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Featured Projects" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource }) => {
      return (
        <div
          class="mb-12 overflow-hidden rounded-2xl border border-neutral/20 bg-black"
        >
          <div class="grid grid-cols-2 h-72 w-full bg-[#1c232d]/85 sm:grid-cols-2 sm:grid-rows-1">
            <div class="px-6 pt-12">
              <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                {name}
              </h3>
              <p class="text-base text-neutral">{summary}</p>
            </div>
            <div class="flex items-end justify-end overflow-hidden">
              <Image
                class="h-full w-full rounded-ss-xl rounded-ee-2xl object-cover object-center"
                src={image}
                alt={name}
                width="800"
                height="600"
              />
            </div>
          </div>
          <div class="flex gap-5 px-6 py-5 text-white">
            <a
              href={linkSource}
              target="_blank"
              class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
            >
              官网
            </a>
            <a
              href={linkPreview}
              target="_blank"
              class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
            >
              产品详情
            </a>
          </div>
        </div>
      );
    })
  }
</Section>
